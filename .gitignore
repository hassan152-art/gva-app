# dependencies
node_modules/
.pnp
.pnp.js

# env / secrets
.env
.env.local
.env.*.local
!.env.example

# builds
dist/
build/
.expo/
.expo-shared/
web-build/
*.tsbuildinfo

# backend runtime
# User-uploaded payment proofs are runtime data and stay out of git.
backend/uploads/*
!backend/uploads/.gitkeep
# Official orphan posters are published content, not user uploads: they are
# part of the seed data, so they ARE tracked.
!backend/uploads/orphans/
!backend/uploads/orphans/*
backend/.pgdata/
backend/.pg-tmp/
backend/db-server.log
backend/db-start.log
backend/.pgpw.tmp

# design preview artifacts (regenerated by scripts/visual)
design/diffs/*.actual.png
design/diffs/*.heat.png
design/diffs/*.side.png
design/diffs/_*

# logs / OS
*.log
npm-debug.log*
.DS_Store
Thumbs.db
