# ---- Gaza Virtual Adoption API ----
# Copy this file to .env and fill in the values for your Postgres instance.

PORT=4000
NODE_ENV=development

# --- Database ---
# Either provide a single URL...
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/gva
# ...or the individual fields below (used when DATABASE_URL is empty).
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=gva
PGUSER=postgres
PGPASSWORD=postgres
# Set to "true" when connecting to a managed Postgres that requires TLS.
PGSSL=false

# --- Auth ---
# Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Uploads (Cloudious → Google Drive folder GVA-APP) ---
CLOUDIOUS_API_KEY=
CLOUDIOUS_UPLOAD_URL=https://gdrive.cloudious.net/upload
CLOUDIOUS_UPLOAD_TIMEOUT_MS=120000
# In development, when CLOUDIOUS_API_KEY is empty, uploads are stubbed unless set to false.
CLOUDIOUS_DEV_STUB=
MAX_UPLOAD_MB=5
# Legacy local proof files only (older rows); new uploads use Cloudious.
UPLOAD_DIR=uploads

# --- Official orphan roster (gazavirtualadoption.org / Elixir Strapi) ---
# Public site reads fop-vads with a read token; set the same token here for live lists.
ELIXIR_API_URL=https://elixir.cloudious.net/api
ELIXIR_MEDIA_URL=https://elixir.cloudious.net
ELIXIR_STRAPI_TOKEN=
DEFAULT_MONTHLY_PKR=30000

# --- CORS ---
# Comma-separated list of allowed origins, or * for all (development only).
CORS_ORIGIN=*
